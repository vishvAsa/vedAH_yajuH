			<atom:link href="https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/index.xml" rel="self" type="application/rss+xml" />
			<item>
				<title>०१</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/01/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/01/</guid>
				<description>&lt;p&gt;शादं दद्भिरवकान्दन्तमूलैस्तेगान्दँष्ट्राभ्यां मण्डूकाञ्जम्भैरादकां&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; खानोँर्ज सँसीदेनारण्यं जाम्बीलेन मृदं बर्स्वैश्शर्कराभिरवकामवकाभिश्शर्करामुत्सादेन&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt; जिव्हामवक्रन्देन तालुँ सरस्वतीं जिह्वाग्रेया॥१॥ cf. TS 5, 7, 11; MS 3, 15, 1; VS 25, 1.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;Ch रादकान्खा॰ ; vgl. 5, 7, 11. (Ch रादकान्खा॰; cf. 5, 7, 11.)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So corr. बन्द्वैः (Thus emended from बन्द्वैः)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>०२</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/02/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/02/</guid>
				<description>&lt;p&gt;वाजँ हनुभ्यामप आस्येनादित्याञ्छ्मश्रुभिरुपयाममधरोष्ठेन&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; सदुत्तरेणान्तरेणानूकाशं&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt; प्रकाशं प्रकाशेन बाह्यँ स्तनयित्नुं निर्बाधेन सूर्याग्नी चक्षुर्भ्यां विद्युतं कनीनिकाभ्यामशनिं मस्तिष्केण बलं मज्जभिः॥२॥ cf. TS 5, 7, 12; MS 3, 15, 1.2; VS 25, 1.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;Ch त्यां श्मश्रु°&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So corr. Ch सद्वत्तरेणा ; vgl. TS 5, 7, 12, 1; MS 3, 15, 2. (Thus emended; Ch reads सद्वत्तरेणा; cf. TS 5, 7, 12, 1; MS 3, 15, 2)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>०३</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/03/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/03/</guid>
				<description>&lt;p&gt;कूर्माञ्छफैरच्छराभिः&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; कपिञ्जलान्साम कुष्ठिकाभिर्जवं जङ्घाभिरगदं जानुभ्यां वीर्यं गुहाभ्यां&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt; भयं प्रचलाभ्यां गुहोपपक्षाभ्यामश्विना अँसाभ्यामदितिँ शीर्ष्णा निर्ऋतिं&lt;sup id=&#34;fnref:3&#34;&gt;&lt;a href=&#34;#fn:3&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;3&lt;/a&gt;&lt;/sup&gt; निर्जाल्माकशीर्ष्णा॥३॥ cf. TS 5, 7, 13; MS3, 15, 3; VS 25, 3.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;Ch कूर्मां छपैरश्छरा ; vgl. TS 5, 7, 13; MS 3, 15, 3; VS 25, 3. (Ch कूर्मां छपैरश्छरा; cf. TS 5, 7, 13; MS 3, 15, 3; VS 25, 3.)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So Ch; vgl. TS 5, 7, 13 कुहा᳓भ्यां (Thus Ch; cf. TS 5, 7, 13 कुहा᳓भ्यां)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:3&#34;&gt;&#xA;&lt;p&gt;So corr. Ch निनृतिन्नि॰ (Thus emended; Ch reads निनृतिन्नि॰)&amp;#160;&lt;a href=&#34;#fnref:3&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>०४</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/04/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/04/</guid>
				<description>&lt;p&gt;योक्त्रं गृध्राभिर्युगमानतेन चित्तं मन्याभिस्सङ्घोषात्प्राणैः&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; प्रकाशेन त्वचं पराकाशेनान्तरां&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt; मशकान्केशैरिन्द्रँ&lt;sup id=&#34;fnref:3&#34;&gt;&lt;a href=&#34;#fn:3&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;3&lt;/a&gt;&lt;/sup&gt; स्वपसा वहेन&lt;sup id=&#34;fnref:4&#34;&gt;&lt;a href=&#34;#fn:4&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;4&lt;/a&gt;&lt;/sup&gt; बृहस्पतिँ शकुनिसादेन रथमुष्णिहाभिः॥४॥ cf TS 5, 7, 14&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So corr. Ch चित्तमान्याभिस्सङ्गोषान्प्रा॰ ; vgl. TS 5, 7, 14 चित्तम्म᳓न्याभिः सङ्क्रोशा᳓न् (Thus emended Ch चित्तमान्याभिस्सङ्गोषान्प्रा॰; cf. TS 5, 7, 14 चित्तम्म᳓न्याभिः सङ्क्रोशा᳓न्)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So corr. Ch पाकाशे॰ ; vgl. TS 5, 7, 14 (Thus emended; Ch reads पाकाशे॰; cf. TS 5, 7, 14)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:3&#34;&gt;&#xA;&lt;p&gt;So corr. Ch न्तरास्वशका॰ ; vgl. TS 5, 7, 24. (Thus emended; Ch reads न्तरास्वशका॰; cf. TS 5, 7, 24)&amp;#160;&lt;a href=&#34;#fnref:3&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:4&#34;&gt;&#xA;&lt;p&gt;So corr. Ch वहैन; vgl. TS 5, 7, 14 (Thus emended; Ch reads वहैन; cf. TS 5, 7, 14)&amp;#160;&lt;a href=&#34;#fnref:4&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>०५</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/05/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/05/</guid>
				<description>&lt;p&gt;मित्रावरुणौ श्रोणिभ्यामिन्द्राग्नी शिखण्डाभ्यामिन्द्राबृहस्पती ऊरुभ्यामिन्द्राविष्णू अष्ठीवद्भ्याँ सवितारं&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; पुच्छेन गन्धर्वाञ्छेपेनाप्सरसो मुष्काभ्यां पवमानं पायुना पवित्रं पोत्राभ्यामाक्रमणँ स्थूराभ्यां प्रतिक्रमणं गृष्ठाभ्याम्&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt;॥५॥ cf. TS 5, 7, 15.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So corr. Ch सवितानं; vgl. TS 5, 7, 15. (Thus emended; Ch reads सवितानं; cf. TS 5, 7, 15)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So Ch; vgl. कु᳓ष्ठाभ्यां TS 5, 7, 15; MS 3, 15, 6. E.; VS 25, 6. (Thus Ch; cf. कु᳓ष्ठाभ्यां TS 5, 7, 15; MS 3, 15, 6. E.; VS 25, 6.)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>०६</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/06/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/06/</guid>
				<description>&lt;p&gt;इन्द्रस्य क्रोडो&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt;ऽदित्यै पाजस्यं दिशां जत्रवो जीमूतान्हृदयोपशाभ्यामन्तरिक्षं&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt; पुलितता नभ उदर्येणेन्द्राणीं&lt;sup id=&#34;fnref:3&#34;&gt;&lt;a href=&#34;#fn:3&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;3&lt;/a&gt;&lt;/sup&gt; प्लीहाू&lt;sup id=&#34;fnref:4&#34;&gt;&lt;a href=&#34;#fn:4&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;4&lt;/a&gt;&lt;/sup&gt; वल्मीकान्क्लीम्ना गिरीन्प्लाशिभिस्समुद्रमुदरेण वैश्वानरं भस्मना॥६॥&lt;br&gt;&#xA;cf. TS 5, 7, 16; MS 3, 15, 7; VS 25, 8.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So corr, Ch केडो; vgl. TS 5, 7, 16; MS3, 15, 7; VS 25, 8. (Thus emended Ch केडो; cf. TS 5, 7, 16; MS3, 15, 7; VS 25, 8.)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So corr. Ch जीवामूतान्हदयोप॰ ; vgl. TS 5, 7, 16; MS3, 15, 7; VS 25, 8. (Thus emended; Ch reads जीवामूतान्हदयोप॰; cf. TS 5, 7, 16; MS3, 15, 7; VS 25, 8)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:3&#34;&gt;&#xA;&lt;p&gt;So corr. Ch णैन्द्राणी; vgl. TS 5, 7, 16. (Thus emended; Ch reads णैन्द्राणी; cf. TS 5, 7, 16)&amp;#160;&lt;a href=&#34;#fnref:3&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:4&#34;&gt;&#xA;&lt;p&gt;So corr. Ch प्लीह (Thus emended; Ch reads प्लीह)&amp;#160;&lt;a href=&#34;#fnref:4&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>०७</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/07/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/07/</guid>
				<description>&lt;p&gt;पूष्णो वनिष्ठुरन्धाहेस्स्थूरगुदा&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; सर्पान्गुदाभिर्ऋतून्पृष्टिभिर्दिवं&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt; पृष्ठेन वसूनां प्रथमा&lt;sup id=&#34;fnref:3&#34;&gt;&lt;a href=&#34;#fn:3&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;3&lt;/a&gt;&lt;/sup&gt; कीकसा रुद्राणां द्वितीयादित्यानां तृतीयाङ्गिरसां चतुर्थी साध्यानां पञ्चमी विश्वेषां देवानाँ षष्ठी॥७॥ cf. TS 5, 7, 17; MS 3, 15, 9; VS 25, 7.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So corr. Ch न्ध्राहेस्थुरगुदा; vgl. TS 5, 7, 17; MS 3, 15, 9; VS 25, 7. (Thus emended; Ch reads न्ध्राहेस्थुरगुदा; cf. TS 5, 7, 17; MS 3, 15, 9; VS 25, 7)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So corr. Ch भृष्टि॰ (Thus emended; Ch reads भृष्टि॰)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:3&#34;&gt;&#xA;&lt;p&gt;So corr. Ch पूध्वमा (Thus emended; Ch reads पूध्वमा)&amp;#160;&lt;a href=&#34;#fnref:3&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>०८</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/08/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/08/</guid>
				<description>&lt;p&gt;ओजो ग्रीवाभिर्निर्ऋतिमस्थभिरिन्द्रँ स्वपसा वहेन रुद्रस्य विचलस्स्कन्धोऽहोरात्रयोर्द्वितीयोऽर्धमासानां तृतीयो मासश्चतुर्थम् ऋतूनां पञ्चमस्संवत्सरस्य षष्ठः॥८॥ cf. TS 5, 7, 18.&lt;/p&gt;</description>
			</item>
			<item>
				<title>०९</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/09/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/09/</guid>
				<description>&lt;p&gt;आनन्दनन्दथुभ्यां कामं प्रत्यासाभ्यां भयँ शितीमद्भ्यां&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; प्रशिषं प्रशासाभ्याँ सूर्याचन्द्रमसौ वृक्काभ्याँ श्यामशबलौ मतस्नाभ्यां व्युष्टिं रूपेण निम्नुक्तिमरूपेण&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt;॥९॥ cf. TS 5, 7, 19.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So Ch; vgl. शितोम᳓भ्यां TS 5, 7, 19. (Thus Ch; cf. शितोम᳓भ्यां TS 5, 7, 19.)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So corr. Ch निमूक्ति॰; vgl. TS 5, 7, 19. (Thus emended; Ch reads निमूक्ति॰; cf. TS 5, 7, 19)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>१०</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/10/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/10/</guid>
				<description>&lt;p&gt;अहर्माँसेन रात्रीं पीवसापो यूषेण घृतं रसेन श्यां वसया दूषीकाभिर्ह्र᳙दुनिमश्रुभिः प्रुष्वां दिवं रूपेण नक्षत्राणि प्रतिरूपेण पृथिवीं चर्मणा कवीं&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; छव्योपाकृताय स्वाहालब्धाय स्वाहा हुताय स्वाहा॥१०॥ cf. TS 5, 7, 20.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So Ch; vgl. TS 5, 7, 20 छवं᳓ते छ॰ (Thus Ch; cf. TS 5, 7, 20 छवं᳓ते छ॰)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>११</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/11/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/11/</guid>
				<description>&lt;p&gt;अग्नेः पक्षतिस्सरस्वत्या निपक्षतिस्सोमस्य तृतीयायां चतुर्थ्योषधीनां पञ्चमी रुद्रस्य षष्ठी मरुताँ सप्तमी बृहस्पतेरष्टमी मित्रस्य नवमी वरुणस्य दशमीन्द्रस्यैकादशी विश्वेषां देवानां द्वादशी द्यावापृथिव्योः पार्श्वं यमस्य पाटोरः&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt;॥११॥ cf. TS 5, 7, 21; MS 3, 15, 4; VS 25, 4.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So Ch; vgl. पाटूरः᳓ TS 5, 7, 21. (Thus Ch; cf. पाटूरः᳓ TS 5, 7, 21.)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>१२</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/12/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/12/</guid>
				<description>&lt;p&gt;वायोः पक्षतिस्सरस्वतो निपक्षतिश्चन्द्रमसस्तृतीया नक्षत्राणां चतुर्थी सवितुः पञ्चमी संवत्सरस्य षष्ठी सर्पाणाँ&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt; सप्तम्यर्यम्णोऽष्टमी धातुर्नवमी त्वष्टुर्दशमीन्द्राण्या एकादश्यदित्या द्वादशी द्यावापृथिव्योः पार्श्वं यम्याः पाटोरः&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt;॥१२॥ cf. TS 5, 7, 22; MS 3, 15, 5; VS 25, 5.&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So corr. Ch सप्तानाँ; vgl. TS 5, 7, 22; MS 3, 15, 5; VS 25, 5. (Thus emended; Ch reads सप्तानाँ; cf. TS 5, 7, 22; MS 3, 15, 5; VS 25, 5)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So corr. nach dem vorigen Capitel; Ch पटेरः ; vgl. TS 5, 7, 22 पाटू᳓रः (Thus emended after the preceding chapter; Ch reads पटेरः; cf. TS 5, 7, 22 पाटू᳓रः)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
			<item>
				<title>१३</title>
				<link>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/13/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>https://vishvAsa.github.io/vedAH_yajuH/kAThakam/kaTha-kapiShTalAH/saMhitA/mUlam/schroeder/5_ashvamedhaH/13_shAdAnuvachanam/13/</guid>
				<description>&lt;p&gt;पन्थामनुवृग्भ्याँ सन्ततिँ स्नावन्याभ्याँ शुकान्पित्तेन हरिमाणं यन्का हलिक्ष्णान्पापवातेन कूश्माञ्छकभिश्शवर्तानूवध्येन शुनो विशासनेन सर्पांल्लोहितगन्धेन वयाँसि पक्वगन्धेन पिपीलिकाः प्रशादेन॥१३॥ &lt;em&gt;cf.&lt;/em&gt; TS 5, 7, 23.&lt;/p&gt;&#xA;&lt;p&gt;इति शादानुवचनं त्रयोदशम्॥&lt;sup id=&#34;fnref:1&#34;&gt;&lt;a href=&#34;#fn:1&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;1&lt;/a&gt;&lt;/sup&gt;&lt;/p&gt;&#xA;&lt;p&gt;इत्येकोत्तरशताध्वर्युशाखाप्रभेदभिन्ने श्रीमद्यजुर्वेदकाठके चरकशाखायामश्वमेधो नाम पञ्चमो ग्रन्थः सम्पूर्णः॥ ओं सम्पूर्णा चरकशाखा॥ ओं नमो ब्रह्मणे॥ भद्रम्॥ शिवम्॥ शुभमस्तु॥ ॥ ॥ ओं शुभमस्तु सर्वजगताम् ॥ ओं नमो ब्रह्मणे॥&lt;sup id=&#34;fnref:2&#34;&gt;&lt;a href=&#34;#fn:2&#34; class=&#34;footnote-ref&#34; role=&#34;doc-noteref&#34;&gt;2&lt;/a&gt;&lt;/sup&gt;&lt;/p&gt;&#xA;&lt;div class=&#34;footnotes&#34; role=&#34;doc-endnotes&#34;&gt;&#xA;&lt;hr&gt;&#xA;&lt;ol&gt;&#xA;&lt;li id=&#34;fn:1&#34;&gt;&#xA;&lt;p&gt;So die Unterschrift des Capitels in Ch. (Thus the colophon of the chapter in Ch)&amp;#160;&lt;a href=&#34;#fnref:1&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;li id=&#34;fn:2&#34;&gt;&#xA;&lt;p&gt;So die Unterschrift dieses Buches und damit des ganzen Textes in Ch. (Thus the colophon of this book and thereby of the entire text in Ch.)&amp;#160;&lt;a href=&#34;#fnref:2&#34; class=&#34;footnote-backref&#34; role=&#34;doc-backlink&#34;&gt;&amp;#x21a9;&amp;#xfe0e;&lt;/a&gt;&lt;/p&gt;&#xA;&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;/div&gt;</description>
			</item>
	</channel>
